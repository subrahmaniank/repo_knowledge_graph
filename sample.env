# Local Neo4j instance
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<local-password>
NEO4J_DATABASE=neo4j
# AURA_INSTANCEID=
# AURA_INSTANCENAME=

# Cloud Neo4j Aura instance (example)
# NEO4J_URI=neo4j+s://c60ed9d7.databases.neo4j.io
# NEO4J_USERNAME=c60ed9d7
# NEO4J_PASSWORD=<cloud-password>
# NEO4J_DATABASE=c60ed9d7
# AURA_INSTANCEID=c60ed9d7
# AURA_INSTANCENAME=Instance01

REPO_URL=https://github.com/pallets-eco/flask-admin.git
NEO4J_BATCH_SIZE=500
